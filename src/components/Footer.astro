  <div class="wrap footer-grid">
    <div>
      <a class="logo" href="/">Studiyo</a>
      <p>The mascot studio for consumer apps.</p>
    </div>
    <nav class="footer-links" aria-label="Footer">
      <a href="/#work">Work</a>
      <a href="/#how-we-work">How we work</a>
      <a href={site.x} target="_blank" rel="noopener noreferrer">X</a>
      <a href={site.book} target="_blank" rel="noopener noreferrer">Book a call</a>
    </nav>
    <p class="legal">© Studiyo {year}<br />Worldwide</p>
  </div>
</footer>
