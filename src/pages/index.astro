---
import Base from '../layouts/Base.astro';
import Video from '../components/Video.astro';
import { clips } from '../data/media';
import { site } from '../data/site';

const reel = [
  ['01', 640, 640],
  ['02', 854, 640],
  ['03', 854, 640],
  ['04', 1138, 640],
  ['05', 854, 640],
  ['06', 640, 640],
  ['07', 854, 640],
  ['08', 854, 640],
  ['09', 1138, 640],
  ['10', 1138, 640],
] as const;
const reelLoop = [...reel, ...reel];

// TODO: confirm tools with Devanshu
// Listed: Rive. Named in the Parrot case study, the marquee note, and media labels.
// Not listed: Figma, Blender, and After Effects are not named anywhere in this repo.
// 3D renders (m3d-*) and motion films (mo-*) are in the library, but the tool is not named.
// No client logo files are in the repo. Wordmarks below are Tripbff and TradeZella only.
const tools = ['Rive'] as const;

const clients = ['Tripbff', 'TradeZella'] as const;

const services = [
  {
    title: 'Mascot & character design',
    copy: 'A face that belongs in the product. Turnarounds, expressions, and a character people recognize.',
  },
  {
    title: 'In-product mascot animation',
    copy: 'States and emotions that run inside the app, built in Rive. Not a clip stuck on top of the screen.',
  },
  {
    title: '3D mascots & renders',
    copy: 'Badges, reward moments, and product renders when the character needs to feel physical.',
  },
  {
    title: 'Motion design',
    copy: 'Launch films and the clips that introduce the character, from onboarding to a streak.',
  },
] as const;

const faqs = [
  {
    q: 'What do you make?',
    a: 'Mascots for consumer apps, and the motion that puts them in onboarding, streaks, paywalls, and launch.',
  },
  {
    q: 'How long does a project take?',
    a: 'It depends on the character and how many states it needs. Book a call and we will scope it with you.',
  },
  {
    q: 'What does the process look like?',
    a: 'Character first. Then expressions and states. Then the animation inside the product, and the launch content around it.',
  },
  {
    q: 'How much does it cost?',
    a: 'It depends on scope. Book a call and we will price the work with you. There is no public rate card.',
  },
  {
    q: 'What files do we get?',
    a: 'The character, Rive when the motion runs in the app, Lottie or video when that is the right handoff, and the screens they live in.',
  },
  {
    q: 'How do revisions work?',
    a: 'You see the character before it is animated. Revisions sit inside the scope we agree on the call.',
  },
] as const;

const description =
  'Studiyo designs mascots and the motion that brings them to life inside consumer apps, from character to onboarding, streaks, and launch content.';
---

<Base title="Studiyo — The mascot studio for consumer apps" description={description}>
  <section class="hero">
    <div class="wrap">
      <h1>The mascot studio<br />for consumer apps.</h1>
      <p class="lede">
        We design mascots and the motion that brings them to life inside your app, from character to
        onboarding, streaks and launch content.
      </p>
      <div class="actions">
        <a class="cta" href={site.book} target="_blank" rel="noopener noreferrer">Book a call</a>
      </div>
    </div>
  </section>

  <section class="clients" id="clients" aria-labelledby="clients-title">
    <div class="wrap">
      <h2 id="clients-title">Clients we’ve worked with</h2>
      <ul class="wordmarks">
        {clients.map((name) => <li>{name}</li>)}
      </ul>
    </div>
    <div class="marquee" aria-label="Selected mascot animation samples">
      <div class="fade l"></div>
      <div class="fade r"></div>
      <div class="track">
        {
          reelLoop.map(([n, w, h]) => (
            <video
              src={`/assets/works/work-${n}.mp4`}
              width={w}
              height={h}
              style={`aspect-ratio: ${w} / ${h}`}
              muted
              loop
              playsinline
              autoplay
              preload="auto"
              data-marquee
              aria-hidden="true"
            />
          ))
        }
      </div>
    </div>
    <div class="wrap">
      <div class="marquee-note">
        <span>Selected animation frames · built in Rive</span>
        <span>Hover to pause</span>
      </div>
    </div>
  </section>

  <section class="services" id="services" aria-labelledby="services-title">
    <div class="services-panel">
      <h2 id="services-title">Services</h2>
      <p>Mascots, and the motion that puts them inside consumer apps.</p>
      <div class="service-grid">
        {
          services.map((item) => (
            <article>
              <h3>{item.title}</h3>
              <p>{item.copy}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="tools" id="tools" aria-labelledby="tools-title">
    <div class="wrap">
      <h2 id="tools-title">Tools we’re experts in</h2>
      <ul>
        {tools.map((name) => <li>{name}</li>)}
      </ul>
    </div>
  </section>

  <section class="block" id="work" aria-labelledby="work-title">
    <div class="wrap">
      <h2 id="work-title">Work</h2>
      <div class="work-grid">
        <a class="wtile span2 reveal" href="/work/tripbff">
          <div class="media"><Video clip={clips['tripbff-official-mascot']} /></div>
          <div class="cap">
            <div class="k">Tripbff · travel & meetup</div>
            <h3>A companion for the trip</h3>
            <p>The app’s BFF, from wireframe to a character that can travel.</p>
          </div>
        </a>
        <a class="wtile reveal" href="/work/dino">
          <div class="media"><Video clip={clips['dino-streak-screens']} /></div>
          <div class="cap">
            <div class="k">Calorie-tracking app</div>
            <h3>Dino</h3>
            <p>A reason to come back tomorrow.</p>
          </div>
        </a>
        <a class="wtile reveal" href="/work/grok-bot">
          <div class="media"><Video clip={clips['grokbot-widget']} /></div>
          <div class="cap">
            <div class="k">Concept</div>
            <h3>Grok bot</h3>
            <p>A bot with a life outside the chat.</p>
          </div>
        </a>
        <a class="wtile span2 reveal" href="/work/parrot">
          <div class="media"><Video clip={clips['parrot-emotions-rive']} /></div>
          <div class="cap">
            <div class="k">Language-learning app</div>
            <h3>Parrot</h3>
            <p>A language buddy with feelings you can trust.</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <section class="team" id="team" aria-labelledby="team-title">
    <div class="wrap">
      <h2 id="team-title">Team</h2>
      <!-- TODO: founder photo. Do not add names that are not confirmed. -->
      <article class="person">
        <div class="avatar" aria-hidden="true">DS</div>
        <h3>Devanshu Sharma</h3>
        <p>Founder</p>
      </article>
    </div>
  </section>

  <section class="faq" id="faq" aria-labelledby="faq-title">
    <div class="wrap">
      <h2 id="faq-title">FAQ</h2>
      <div class="faq-list">
        {
          faqs.map((item, i) => (
            <details open={i === 0}>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="close" aria-labelledby="close-title">
    <div class="wrap">
      <h2 id="close-title">Give your app<br />a face.</h2>
      <p>Mascot, motion, and the screens they live in.</p>
      <a class="cta" href={site.book} target="_blank" rel="noopener noreferrer">Book a call</a>
    </div>
  </section>
</Base>
