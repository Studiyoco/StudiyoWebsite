---
import Base from '../layouts/Base.astro';
import Video from '../components/Video.astro';
import Cta from '../components/Cta.astro';
import { clips } from '../data/media';
import { site } from '../data/site';

const reel = [
  ['01', 640, 640],
  ['02', 854, 640],
  ['03', 854, 640],
  ['04', 1138, 640],
  ['05', 854, 640],
  ['06', 640, 640],
  ['07', 854, 640],
  ['08', 854, 640],
  ['09', 1138, 640],
  ['10', 1138, 640],
] as const;
const reelLoop = [...reel, ...reel];

const mascots = [
  { id: 'mm-chicken', title: 'Chicken', k: 'Character' },
  { id: 'mm-muse', title: 'Muse', k: 'Redesign' },
  { id: 'mm-pillow', title: 'Pillow', k: 'Character' },
  { id: 'mm-orbit-robot', title: 'Orbit', k: 'Character' },
  { id: 'mm-tobu', title: 'Tobu', k: 'Character' },
  { id: 'mm-llama', title: 'Llamas', k: 'Character' },
  { id: 'mm-red-panda', title: 'Red panda', k: 'Character' },
  { id: 'mm-concept-airbnb-atlas', title: 'Atlas', k: 'Concept · Airbnb' },
  { id: 'mm-concept-doordash-turbo', title: 'Turbo', k: 'Concept · DoorDash' },
] as const;

const motion = [
  { id: 'm3d-achievement-screens', title: 'Achievement badges', k: '3D' },
  { id: 'm3d-pokemon-pack', title: 'Reward pack', k: '3D' },
  { id: 'm3d-ecom-renders', title: 'Product renders', k: '3D' },
  { id: 'mo-app-mascot', title: 'App mascot', k: 'Motion' },
  { id: 'mo-doordash', title: 'DoorDash', k: 'Concept' },
  { id: 'mo-calorie-congrats', title: 'Calorie congrats', k: 'Motion' },
  { id: 'mo-liftoff', title: 'Liftoff', k: 'Concept' },
  { id: 'mo-streak-achievement', title: 'Streak achievement', k: 'Motion' },
] as const;

const steps = [
  ['01', 'Character design', 'A face that belongs to the product.'],
  ['02', 'Expressions & states', 'The feelings people actually hit.'],
  ['03', 'Rive animation', 'Motion that runs inside the app.'],
  ['04', 'Launch content', 'The clips that introduce the character.'],
] as const;

const description =
  'Studiyo designs mascots and the motion that brings them to life inside consumer apps, from character to onboarding, streaks, and launch content.';
---

<Base title="Studiyo — The mascot studio for consumer apps" description={description}>
  <section class="hero">
    <div class="wrap">
      <div class="eyebrow">Mascot studio</div>
      <h1>The mascot studio<br />for consumer apps.</h1>
      <p class="lede">
        We design mascots and the motion that brings them to life inside your app, from character to
        onboarding, streaks and launch content.
      </p>
      <div class="actions">
        <a class="cta lg" href={site.book} target="_blank" rel="noopener noreferrer">Book a call</a>
        <span class="where">Worldwide</span>
      </div>
    </div>
  </section>

  <div class="marquee" aria-label="Selected mascot animation samples">
    <div class="fade l"></div>
    <div class="fade r"></div>
    <div class="track">
      {
        reelLoop.map(([n, w, h]) => (
          <video
            src={`/assets/works/work-${n}.mp4`}
            width={w}
            height={h}
            style={`aspect-ratio: ${w} / ${h}`}
            muted
            loop
            playsinline
            autoplay
            preload="auto"
            data-marquee
            aria-hidden="true"
          />
        ))
      }
    </div>
  </div>
  <div class="wrap">
    <div class="marquee-note">
      <span>Selected animation frames · built in Rive</span>
      <span>Hover to pause</span>
    </div>
  </div>

  <section class="block" id="work" aria-labelledby="work-title">
    <div class="wrap">
      <div class="sec-tag reveal"><span class="idx">01</span> Selected work</div>
      <h2 id="work-title" class="reveal">Four mascots,<br />inside the product.</h2>
      <div class="work-grid">
        <a class="wtile span2 reveal" href="/work/tripbff">
          <div class="media"><Video clip={clips['tripbff-official-mascot']} /></div>
          <div class="cap">
            <div class="k">Tripbff · travel & meetup</div>
            <h3>A companion for the trip</h3>
            <p>The app’s BFF, from wireframe to a character that can travel.</p>
          </div>
        </a>
        <a class="wtile reveal" href="/work/dino">
          <div class="media"><Video clip={clips['dino-streak-screens']} /></div>
          <div class="cap">
            <div class="k">Calorie-tracking app</div>
            <h3>Dino</h3>
            <p>A reason to come back tomorrow.</p>
          </div>
        </a>
        <a class="wtile reveal" href="/work/grok-bot">
          <div class="media"><Video clip={clips['grokbot-widget']} /></div>
          <div class="cap">
            <div class="k">Concept</div>
            <h3>Grok bot</h3>
            <p>A bot with a life outside the chat.</p>
          </div>
        </a>
        <a class="wtile span2 reveal" href="/work/parrot">
          <div class="media"><Video clip={clips['parrot-emotions-rive']} /></div>
          <div class="cap">
            <div class="k">Language-learning app</div>
            <h3>Parrot</h3>
            <p>A language buddy with feelings you can trust.</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <section class="block" id="mascots" aria-labelledby="mascots-title">
    <div class="wrap">
      <div class="sec-tag reveal"><span class="idx">02</span> More mascots</div>
      <h2 id="mascots-title" class="reveal">Characters for products<br />that need a face.</h2>
      <div class="work-grid">
        {
          mascots.map((item) => (
            <figure class="wtile reveal">
              <div class="media">
                <Video clip={clips[item.id]} />
              </div>
              <figcaption class="cap">
                <div class="k">{item.k}</div>
                <h3>{item.title}</h3>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <div class="thesis reveal">
    <div class="narrow">
      <div class="sec-tag">In the product</div>
      <p class="big" id="product-title">
        A mascot on a landing page is nice. A mascot inside your onboarding, streaks and paywall is
        a retention tool.
      </p>
    </div>
  </div>

  <section class="block" id="product" aria-labelledby="product-title">
    <div class="wrap">
      <a class="phone-row reveal" href="/work/dino">
        <img
          src="/assets/img/dino/screens/dino_screen_01_onboarding-food-prefs.webp"
          alt="Dino onboarding screen asking which foods you like"
          width="696"
          height="1400"
          loading="lazy"
          decoding="async"
        />
        <img
          src="/assets/img/dino/screens/dino_screen_02_streak-2-days_a.webp"
          alt="Dino streak screen showing two days"
          width="696"
          height="1400"
          loading="lazy"
          decoding="async"
        />
        <img
          src="/assets/img/dino/screens/dino_screen_03_dashboard-today.webp"
          alt="Dino today dashboard with calories eaten, remaining, and burned"
          width="696"
          height="1400"
          loading="lazy"
          decoding="async"
        />
      </a>
      <div class="work-grid">
        <a class="wtile reveal" href="/work/dino">
          <div class="media"><Video clip={clips['dino-app-screens']} /></div>
          <div class="cap">
            <div class="k">In the app</div>
            <h3>Dino</h3>
          </div>
        </a>
        <a class="wtile reveal" href="/work/parrot">
          <div class="media"><Video clip={clips['parrot-app-screens']} /></div>
          <div class="cap">
            <div class="k">In the app</div>
            <h3>Parrot</h3>
          </div>
        </a>
        <a class="wtile reveal" href="/work/tripbff">
          <div class="media"><Video clip={clips['tripbff-new-app']} /></div>
          <div class="cap">
            <div class="k">In the app</div>
            <h3>Tripbff</h3>
          </div>
        </a>
        <figure class="wtile reveal">
          <div class="media"><Video clip={clips['mm-muse']} /></div>
          <figcaption class="cap">
            <div class="k">Redesign</div>
            <h3>Muse</h3>
          </figcaption>
        </figure>
        <a class="wtile reveal" href="/work/grok-bot">
          <div class="media"><Video clip={clips['grokbot-widget']} /></div>
          <div class="cap">
            <div class="k">Concept</div>
            <h3>Grok widget</h3>
          </div>
        </a>
        <a class="wtile reveal" href="/work/parrot">
          <div class="media"><Video clip={clips['mip-bluebird-paywall']} /></div>
          <div class="cap">
            <div class="k">Paywall</div>
            <h3>Language app</h3>
          </div>
        </a>
        <figure class="wtile span2 reveal">
          <div class="media"><Video clip={clips['mip-recent-work']} /></div>
          <figcaption class="cap">
            <div class="k">Compilation</div>
            <h3>Recent work</h3>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="block" id="motion" aria-labelledby="motion-title">
    <div class="wrap">
      <div class="sec-tag reveal"><span class="idx">03</span> 3D & motion</div>
      <h2 id="motion-title" class="reveal">Badges, rewards,<br />and the moments people feel.</h2>
      <div class="work-grid">
        {
          motion.map((item) => (
            <figure class="wtile reveal">
              <div class="media">
                <Video clip={clips[item.id]} />
              </div>
              <figcaption class="cap">
                <div class="k">{item.k}</div>
                <h3>{item.title}</h3>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <div class="blueprint" id="how-we-work">
    <div class="wrap">
      <div class="sec-tag reveal"><span class="idx">04</span> How we work</div>
      <h2 id="process-title" class="reveal">From a character<br />to the clips that introduce it.</h2>
      <div class="phase-list">
        {
          steps.map(([num, title, line]) => (
            <div class="phase reveal">
              <div class="pn">{num}</div>
              <div class="body">
                <h3>{title}</h3>
                <p>{line}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <Cta />
</Base>
