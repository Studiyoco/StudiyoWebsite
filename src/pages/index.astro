const services = [
  {
    title: 'Mascot & character design',
    copy: 'A face that belongs in the product. Turnarounds, expressions, and a character people recognize.',
  },
  {
    title: 'In-product mascot animation',
    copy: 'States and emotions that run inside the app, built in Rive. Not a clip stuck on top of the screen.',
  },
  {
    title: '3D mascots & renders',
    copy: 'Badges, reward moments, and product renders when the character needs to feel physical.',
  },
  {
    title: 'Motion design',
    copy: 'Launch films and the clips that introduce the character, from onboarding to a streak.',
  },
] as const;

const faqs = [
  {
    q: 'What do you make?',
    a: 'Mascots for consumer apps, and the motion that puts them in onboarding, streaks, paywalls, and launch.',
  },
  {
    q: 'How long does a project take?',
    a: 'It depends on the character and how many states it needs. Book a call and we will scope it with you.',
  },
  {
    q: 'What does the process look like?',
    a: 'Character first. Then expressions and states. Then the animation inside the product, and the launch content around it.',
  },
  {
    q: 'How much does it cost?',
    a: 'It depends on scope. Book a call and we will price the work with you. There is no public rate card.',
  },
  {
    q: 'What files do we get?',
    a: 'The character, Rive when the motion runs in the app, Lottie or video when that is the right handoff, and the screens they live in.',
  },
  {
    q: 'How do revisions work?',
    a: 'You see the character before it is animated. Revisions sit inside the scope we agree on the call.',
  },
] as const;

// Well colours sampled from each poster’s edge pixels.
const studies = [
  {
    clip: 'tripbff-official-mascot',
    href: '/work/tripbff',
    well: '#ffffff',
    kicker: 'Tripbff · travel & meetup',
    title: 'A companion for the trip',
    outcome: 'The app’s BFF, from wireframe to a character that can travel.',
  },
  {
    clip: 'dino-streak-screens',
    href: '/work/dino',
    well: '#ffffff',
    kicker: 'Calorie-tracking app',
    title: 'Dino',
    outcome: 'A reason to come back tomorrow.',
  },
  {
    clip: 'grokbot-widget',
    href: '/work/grok-bot',
    well: '#030710',
    kicker: 'Concept',
    title: 'Grok bot',
    outcome: 'A bot with a life outside the chat.',
  },
  {
    clip: 'parrot-emotions-rive',
    href: '/work/parrot',
    well: '#ffffff',
    kicker: 'Language-learning app',
    title: 'Parrot',
    outcome: 'A language buddy with feelings you can trust.',
  },
] as const;

const team = [
  { name: 'Devan', role: 'Founder · Creative Direction', initials: 'D' },
  { name: 'Bhavi', role: 'Founder · Lead Animator', initials: 'B' },
  { name: 'Janno', role: 'Co-founder · Design Lead', initials: 'J' },
  { name: 'Theo', role: 'Co-founder · Client Partnerships', initials: 'T' },
  { name: 'Olga', role: 'Senior Designer', initials: 'O' },
] as const;

const description =
  'Studiyo designs mascots and the motion that brings them to life inside consumer apps, from character to onboarding, streaks, and launch content.';
---

<Base title="Studiyo — The mascot studio for consumer apps" description={description}>
  <section class="hero">
    <div class="wrap">
      <h1>The mascot studio<br />for consumer apps.</h1>
      <p class="lede">
        We design mascots and the motion that brings them to life inside your app, from character to
        onboarding, streaks and launch content.
      </p>
      <div class="actions">
        <a class="cta" href={site.book} target="_blank" rel="noopener noreferrer">Book a call</a>
      </div>
    </div>
  </section>

  <section class="clients" id="clients" aria-labelledby="clients-title">
    <div class="wrap">
      <h2 id="clients-title">Clients we’ve worked with</h2>
    </div>
    <div class="logo-marquee">
      <div class="fade l"></div>
      <div class="fade r"></div>
      <div class="logo-track">
        {
          clientLogoLoop.map((logo) => (
            <img src={logo.src} alt={logo.name} width={logo.width} height={logo.height} />
          ))
        }
      </div>
    </div>
  </section>

  <section class="services" id="services" aria-labelledby="services-title">
    <div class="services-panel">
      <h2 id="services-title">Services</h2>
      <p>Mascots, and the motion that puts them inside consumer apps.</p>
      <div class="service-grid">
        {
          services.map((item) => (
            <article>
              <h3>{item.title}</h3>
              <p>{item.copy}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="tools" id="tools" aria-labelledby="tools-title">
    <div class="wrap">
      <h2 id="tools-title">Tools we’re experts in</h2>
      <ul>
        {
          tools.map((tool) => (
            <li>
              <svg viewBox={tool.viewBox} aria-hidden="true" focusable="false">
                <path d={tool.path} fill-rule={'evenodd' in tool && tool.evenodd ? 'evenodd' : undefined} />
              </svg>
              <span>{tool.name}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="block" id="work" aria-labelledby="work-title">
    <div class="wrap">
      <h2 id="work-title">Selected case studies</h2>
      <div class="work-grid">
        {
          studies.map((study) => (
            <a class="wtile reveal" href={study.href}>
              <div
                class="well"
                style={`background:${study.well}; --rw:${clips[study.clip].width}; --rh:${clips[study.clip].height}`}
              >
                <Video clip={clips[study.clip]} play="hover" />
              </div>
              <div class="cap">
                <div class="k">{study.kicker}</div>
                <h3>{study.title}</h3>
                <p>{study.outcome}</p>
                <span class="view-case">View case study →</span>
              </div>
            </a>
          ))
        }
      </div>
      <p class="see-all-row">
        <a class="see-all" href="/work">See all work →</a>
      </p>
    </div>
  </section>

  <section class="team" id="team" aria-labelledby="team-title">
    <div class="wrap">
      <h2 id="team-title">Team</h2>
      <ul class="team-list">
        {
          team.map((person) => (
            <li class="person">
              <div class="avatar" aria-hidden="true">{person.initials}</div>
              <h3>{person.name}</h3>
              <p>{person.role}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="faq" id="faq" aria-labelledby="faq-title">
    <div class="wrap">
      <h2 id="faq-title">FAQ</h2>
      <div class="faq-list">
        {
          faqs.map((item, i) => (
            <details open={i === 0}>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="close" aria-labelledby="close-title">
    <div class="wrap">
      <h2 id="close-title">Give your app<br />a face.</h2>
      <p>Mascot, motion, and the screens they live in.</p>
      <a class="cta" href={site.book} target="_blank" rel="noopener noreferrer">Book a call</a>
    </div>
  </section>
</Base>
