  { src: '/assets/logos/indian-motorcycle.png', name: 'Indian Motorcycle', width: 684, height: 256 },
  { src: '/assets/logos/pure-poker.png', name: 'Pure Poker', width: 1214, height: 256 },
  { src: '/assets/logos/alertsify.png', name: 'Alertsify', width: 1093, height: 256 },
  { src: '/assets/logos/menufit.png', name: 'Menufit', width: 957, height: 256 },
  { src: '/assets/logos/liggo.png', name: 'Liggo', width: 869, height: 256 },
  { src: '/assets/logos/v21-studios.png', name: 'V21 Studios', width: 480, height: 256 },
