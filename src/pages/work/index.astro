---
import Base from '../../layouts/Base.astro';
import Video from '../../components/Video.astro';
import { gallery, galleryFilters, galleryTags, type GalleryPiece } from '../../data/gallery';

const description = 'App design, 3D, mascots, and motion from Studiyo.';

function clipFor(piece: GalleryPiece) {
  if (!piece.src || !piece.poster) return null;
  return {
    src: piece.src,
    poster: piece.poster,
    width: piece.width,
    height: piece.height,
    label: piece.title,
    concept: false,
  };
}
---

<Base title="Work — Studiyo" description={description}>
  <div class="work-index">
    <header class="wrap">
      <h1>Work</h1>
      <p>Mascots, motion, and the screens they live in.</p>
    </header>
    <div class="wrap">
      <div class="work-filters" role="tablist" aria-label="Filter work">
        {
          galleryFilters.map((filter) => (
            <button
              type="button"
              role="tab"
              class:list={[{ on: filter.id === 'app' }]}
              data-filter={filter.id}
              aria-pressed={filter.id === 'app' ? 'true' : 'false'}
            >
              {filter.label}
            </button>
          ))
        }
      </div>
      <div class="gallery">
        {
          gallery.map((piece) => {
            const clip = clipFor(piece);
            return (
              <article class="piece" data-cat={piece.cat} hidden={piece.cat !== 'app'}>
                {clip ? (
                  <Video clip={clip} />
                ) : (
                  <div class="vid" style={`aspect-ratio: ${piece.width} / ${piece.height}`}>
                    <img
                      src={piece.image}
                      alt={piece.title}
                      width={piece.width}
                      height={piece.height}
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                )}
                <div class="piece-cap">
                  <span class="tag">{galleryTags[piece.cat]}</span>
                  <h2>{piece.title}</h2>
                  {piece.x && (
                    <a class="xlink" href={piece.x} target="_blank" rel="noopener noreferrer">
                      View on X
                    </a>
                  )}
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </div>
</Base>

<script>
  const root = document.querySelector('.work-index');
  if (root) {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('.work-filters button')];
    const pieces = [...root.querySelectorAll<HTMLElement>('.piece')];
    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const filter = button.dataset.filter || 'app';
        buttons.forEach((other) => {
          const on = other === button;
          other.classList.toggle('on', on);
          other.setAttribute('aria-pressed', on ? 'true' : 'false');
        });
        pieces.forEach((piece) => {
          piece.hidden = piece.dataset.cat !== filter;
        });
      });
    });
  }
</script>
